# ---------------------------------------------------------------------------
# Iṣẹ́ environment configuration
# Copy to .env and fill in. Nothing here is required except DATABASE_URL and the
# JWT secrets; every external provider degrades to a safe local implementation
# (documented in README.md) when its credentials are absent.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Comma separated list of allowed browser origins. Include 5174 if Vite falls
# back to its next port because 5173 is already in use.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4000

# PostgreSQL. docker-compose sets these automatically for the api service.
DATABASE_URL=postgresql://ise:ise_password@localhost:5432/ise?schema=public

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-64-hex-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# AES-256-GCM key for demographic + sensitive data at rest.
# 64 hex chars (32 bytes). Rotating this makes existing records unreadable.
FIELD_ENCRYPTION_KEY=replace-me-with-64-hex-chars

# --- File storage -----------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- AI ---------------------------------------------------------------------
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, OpenRouter, Groq, local).
# With no LLM_API_KEY the deterministic rubric-only scorer is used and scores are
# tagged model="rubric-v1" so the difference is always visible in the UI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
PROMPT_VERSION=2026-02-v1

# --- Email ------------------------------------------------------------------
# console (default, logs to stdout) | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Iṣẹ́ <no-reply@ise.example>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS / WhatsApp (Termii, Nigeria) --------------------------------------
# console | termii
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Ise
TERMII_BASE_URL=https://api.ng.termii.com

# --- Queue / cache ----------------------------------------------------------
# Leave empty to use the in-process worker fallback.
REDIS_URL=

# --- Google Calendar (optional) --------------------------------------------
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Bias audit defaults ----------------------------------------------------
# Groups smaller than this are suppressed in reports.
AUDIT_MIN_GROUP_SIZE=5
# Four-fifths rule threshold.
AUDIT_ADVERSE_IMPACT_THRESHOLD=0.8
# Counterfactual score gap (points) that triggers a flag.
AUDIT_COUNTERFACTUAL_THRESHOLD=5
# Days to retain CV files / demographic declarations (NDPA minimisation).
DATA_RETENTION_DAYS=365
# Demo-only switch used by the seeded "biased" job.
ALLOW_BIAS_DEMO=true
